{
  "schema_version": "agentic-systems.studio/v1",
  "id": "research-synthesis",
  "name": "Research Synthesis",
  "agentic_systems_version": "2.0.0",
  "size": "medium",
  "stages": [
    {
      "id": "extract",
      "name": "Evidence operator",
      "kind": "operator",
      "capability": "evidence-extraction",
      "tool_key": "extract_research_evidence",
      "instructions": "Extract claims, links, figures and uncertainty."
    },
    {
      "id": "synthesize",
      "name": "Research synthesizer",
      "kind": "reasoner",
      "capability": "evidence-synthesis",
      "tool_key": "record_reasoning_evidence",
      "instructions": "Synthesize only extracted evidence and retain uncertainty."
    },
    {
      "id": "critic",
      "name": "Adversarial critic",
      "kind": "reasoner",
      "capability": "claim-criticism",
      "tool_key": "record_reasoning_evidence",
      "instructions": "Find contradictions, missing evidence and overclaiming."
    },
    {
      "id": "review",
      "name": "Research editor",
      "kind": "reviewer",
      "capability": "editorial-review",
      "tool_key": "validate_review_claim",
      "instructions": "Produce the evidence-qualified synthesis."
    }
  ],
  "capabilities": [
    "evidence-extraction",
    "evidence-synthesis",
    "claim-criticism",
    "editorial-review"
  ],
  "assets": [
