    "src/creator_proof/environment.py",
    "src/creator_proof/evals.py",
    "skills/codex-agentic-application/SKILL.md",
    "skills/runtime/safe-incident-response.json",
    "assets/system.mmd",
    "notebooks/00_walkthrough.ipynb",
    "tests/test_contract.py",
    "data/app.db"
  ],
  "catalog_assets": [
