# Studio contract. This file is canonical; the UI displays it read-only.
AGENTIC_SYSTEMS_PROVIDER=auto
AGENTIC_SYSTEMS_FRAMEWORK=native
AGENTIC_SYSTEMS_MODEL=
AGENTIC_SYSTEMS_TIMEOUT_S=120
AGENTIC_SYSTEMS_MAX_TURNS=6
AGENTIC_SYSTEMS_MAX_TOOL_CALLS=4
AGENTIC_SYSTEMS_MAX_TOKENS=1024
RUN_STUDIO_LIVE=1

# Provider selection order when AGENTIC_SYSTEMS_PROVIDER=auto.
AGENTIC_SYSTEMS_PROVIDER_PRIORITY=bedrock-runtime,openai-runtime,vllm-runtime,ollama-runtime

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bedrock: leave the bearer token empty for the boto3/IAM credential chain.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:4b-instruct

# vLLM OpenAI-compatible endpoint.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=vllm
VLLM_MODEL=unsloth/Qwen3-0.6B

# Streamlit/JupyterLab launcher.
AGENTIC_SYSTEMS_STUDIO_PORT=8501
AGENTIC_SYSTEMS_STUDIO_PROXY_PREFIX=/jupyterlab/default/proxy
