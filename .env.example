# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
RUN_OPENAI_LIVE=0

# Amazon Bedrock short-term API key (use an inference profile ID or ARN).
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your_inference_profile_id_or_arn
RUN_BEDROCK_LIVE=0
# Alternative for the standard AWS/ADA credential chain:
# AWS_PROFILE=your_profile

# Ollama local OpenAI-compatible server
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct
RUN_OLLAMA_LIVE=0

# vLLM OpenAI-compatible server
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=your_model
VLLM_API_KEY=vllm
RUN_VLLM_LIVE=0

# Optional explicit priority for provider="auto"
AGENTIC_SYSTEMS_PROVIDER_PRIORITY=bedrock-runtime,openai-runtime,vllm-runtime,ollama-runtime
