# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
RUN_OPENAI_LIVE=0

# Amazon Bedrock. .env is the canonical selector for both authentication routes.
# Leave AWS_BEARER_TOKEN_BEDROCK empty for SageMaker/ADA/IAM credential-chain auth.
# Set it only when this environment must use a Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your_inference_profile_id_or_arn
# 0 uses Converse (portable baseline); 1 uses ConverseStream and requires
# bedrock:InvokeModelWithResponseStream in IAM.
BEDROCK_STREAMING=0
RUN_BEDROCK_LIVE=0
# Optional outside managed AWS environments:
# AWS_PROFILE=your_profile

# Ollama local OpenAI-compatible server
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
RUN_OLLAMA_LIVE=0

# vLLM OpenAI-compatible server. Values here override hardware fallbacks.
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=unsloth/Qwen3-4B-Instruct-2507
VLLM_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
VLLM_PROFILE=auto
VLLM_DTYPE=
VLLM_TOOL_CALL_PARSER=hermes
VLLM_REASONING_PARSER=qwen3
VLLM_API_KEY=vllm
RUN_VLLM_LIVE=0

# Canonical provider selector used by framework tutorials and Studio.
# Keep auto to resolve from configured signals, or set one explicit runtime.
AGENTIC_SYSTEMS_PROVIDER=auto

# Optional explicit priority for provider="auto"
AGENTIC_SYSTEMS_PROVIDER_PRIORITY=bedrock-runtime,openai-runtime,vllm-runtime,ollama-runtime
