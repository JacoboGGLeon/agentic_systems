[importlinter]
root_package = agentic_systems

[importlinter:contract:schemas_are_independent]
name = Schemas do not depend on executable or presentation layers
type = forbidden
source_modules =
    agentic_systems._engine.schemas
forbidden_modules =
    agentic_systems._engine.agents
    agentic_systems._engine.system
    agentic_systems._engine.providers
    agentic_systems._engine.integrations
    agentic_systems.cli

[importlinter:contract:providers_do_not_import_presentation]
name = Provider adapters do not depend on presentation
type = forbidden
source_modules =
    agentic_systems._engine.providers
forbidden_modules =
    agentic_systems.cli
    agentic_systems._engine.human_output

[importlinter:contract:integrations_do_not_import_presentation]
name = Framework adapters do not depend on presentation
type = forbidden
source_modules =
    agentic_systems._engine.integrations
forbidden_modules =
    agentic_systems.cli
    agentic_systems._engine.human_output
