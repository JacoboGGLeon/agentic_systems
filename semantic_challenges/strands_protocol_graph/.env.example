# .env is canonical. Process environment is fallback only.
AGENTIC_SYSTEMS_PROVIDER=openai-runtime
AGENTIC_SYSTEMS_PROVIDER_PRIORITY=openai-runtime,bedrock-runtime,ollama-runtime,vllm-runtime

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RUN_OPENAI_LIVE=1

# Empty selects boto3/IAM credential chain. Non-empty selects Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
RUN_BEDROCK_LIVE=1

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct
RUN_OLLAMA_LIVE=1

VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=vllm
VLLM_MODEL=unsloth/Qwen3-4B-Instruct-2507
RUN_VLLM_LIVE=1

OPENAI_AGENTS_DISABLE_TRACING=1
