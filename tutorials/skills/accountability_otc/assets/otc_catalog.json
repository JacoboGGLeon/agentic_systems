{
  "version": "accountability.otc_catalog.v3",
  "database_env": "OTC_DATABASE",
  "table_env": "OTC_TABLE",
  "workgroup_env": "OTC_WORKGROUP",
  "default_database": "mx_master",
  "default_table": "t_mrdc_mthly_invty_otc",
  "default_workgroup": "sandbox",
  "date_column": "load_date",
  "columns": [
    {
      "name": "load_date",
      "role": "date",
      "data_type": "date",
      "aliases": [
        "fecha",
        "fecha de carga",
        "cierre",
        "load date"
      ]
    },
    {
      "name": "product_type",
      "role": "dimension",
      "data_type": "string",
      "aliases": [
        "producto",
        "tipo de producto",
        "product",
        "product type"
      ],
      "description": "Tipo de producto OTC."
    },
    {
      "name": "currency_id",
      "role": "dimension",
      "data_type": "string",
      "aliases": [
        "moneda",
        "divisa",
        "currency",
        "currency id"
      ],
      "description": "Moneda o divisa de la operación."
    },
    {
      "name": "financial_asset_class_type",
      "role": "dimension",
      "data_type": "string",
      "aliases": [
        "clase de activo",
        "asset class",
        "tipo de activo",
        "activo"
      ],
      "description": "Clase de activo financiero."
    },
    {
      "name": "counterparty_name",
      "role": "dimension",
      "data_type": "string",
      "aliases": [
        "contraparte",
        "counterparty",
        "cliente"
      ],
      "description": "Contraparte o cliente."
    },
    {
      "name": "gl_account_id",
      "role": "dimension",
      "data_type": "string",
      "aliases": [
        "cuenta contable",
        "cuenta gl",
        "gl account",
        "gl"
      ],
      "description": "Cuenta contable GL."
    },
    {
      "name": "nominal_amount",
      "role": "metric",
      "data_type": "number",
      "aliases": [
        "nominal",
        "notional",
        "exposición nominal",
        "exposicion nominal",
        "exposure",
        "monto nominal"
      ],
      "description": "Monto nominal de la operación."
    },
    {
      "name": "market_valuation_amount",
      "role": "metric",
      "data_type": "number",
      "aliases": [
        "mtm",
        "mark to market",
        "valor mercado",
        "valor de mercado",
        "valuación",
        "valuacion"
      ],
      "description": "Valuación de mercado o MTM."
    },
    {
      "name": "gl_account_amount",
      "role": "metric",
      "data_type": "number",
      "aliases": [
        "saldo contable",
        "contabilidad",
        "importe contable",
        "accounting",
        "gl amount"
      ],
      "description": "Importe contable asociado."
    }
  ],
  "semantic_layer": {
    "description": "Capa semántica mínima para compilar preguntas naturales OTC a SQL seguro sobre la tabla autorizada.",
    "default_dimension": "product_type",
    "default_metric": "nominal_amount",
    "include_count_by_default": true,
    "count_alias": "operaciones",
    "metrics": {
      "nominal_amount": {
        "aggregate": "SUM",
        "output_alias": "total_nominal",
        "default_order": "DESC"
      },
      "market_valuation_amount": {
        "aggregate": "SUM",
        "output_alias": "total_mtm",
        "default_order": "ABS_DESC"
      },
      "gl_account_amount": {
        "aggregate": "SUM",
        "output_alias": "total_contable",
        "default_order": "ABS_DESC"
      }
    },
    "concepts": [
      {
        "name": "exposure",
        "aliases": [
          "exposición",
          "exposicion",
          "exposure",
          "riesgo",
          "concentración",
          "concentracion"
        ],
        "metrics": [
          "nominal_amount",
          "market_valuation_amount"
        ]
      }
    ]
  },
  "nl2sql": {
    "default_dimension": "product_type",
    "default_metric": "nominal_amount",
    "metric_aliases": {
      "nominal_amount": "total_nominal",
      "market_valuation_amount": "total_mtm",
      "gl_account_amount": "total_contable"
    }
  }
}
